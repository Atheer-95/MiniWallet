# Copy to .env and fill in the values. Never commit .env.

# Oracle XE admin (SYS/SYSTEM) password
ORACLE_SYS_PASSWORD=

# Schema owner, used by Flyway
DB_OWNER_PASSWORD=

# Application user, used by the Wallet API at runtime
DB_APP_PASSWORD=

# JWT signing key — generate with: openssl rand -base64 48
JWT_SECRET=

# Mock gateway admin key (for drills)
GATEWAY_ADMIN_KEY=

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=
